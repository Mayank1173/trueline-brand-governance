# Anthropic API Configuration
# Set to enable AI-powered review. Leave empty to run in deterministic-only mode.
ANTHROPIC_API_KEY=

# Model configuration (optional, defaults shown)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.0

# Review Engine Configuration
# When true, AI provider failures will not crash the review; deterministic findings are preserved.
REVIEW_DEGRADED_MODE=true

# Logging (optional)
LOG_LEVEL=INFO