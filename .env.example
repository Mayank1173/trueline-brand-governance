# -----------------------------------------------------------------------------
# Trueline backend (copy this file to backend/.env when running locally)
# All backend settings use the TRUELINE_ prefix. No real secret belongs here.
# -----------------------------------------------------------------------------
TRUELINE_ENVIRONMENT=local
# Local SQLite default. For deployment use a PostgreSQL URL, e.g.:
# TRUELINE_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
TRUELINE_DATABASE_URL=sqlite:///./trueline.db
TRUELINE_AUTO_CREATE_TABLES=true
TRUELINE_SEED_DEMO_DATA=true
TRUELINE_MAX_DRAFT_CHARS=20000
TRUELINE_MAX_PURPOSE_CHARS=200
TRUELINE_MAX_REQUEST_BYTES=1000000
TRUELINE_CORS_ORIGINS=http://localhost:3000
TRUELINE_RULESET_VERSION=demo-ruleset-2026.10
# Optional AI review layer. Disabled by default; deterministic checks always run.
TRUELINE_AI_ENABLED=false
TRUELINE_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Optional AI review engine (backend/trueline). Only used when enabled above.
# Never commit a real key.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.0
REVIEW_DEGRADED_MODE=true

# -----------------------------------------------------------------------------
# Frontend (create frontend/.env.local; never put secrets in NEXT_PUBLIC_*)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Existing placeholders from earlier planning. The backend does not use these.
# Leave blank unless/until an approved integration is added.
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
